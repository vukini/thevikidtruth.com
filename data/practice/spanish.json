"cards": [
{
"f": "aburrido / aburrida",
"b": "boring, tedious; bored (with estar)",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Lo que decía era tan aburrido que me quedé dormido. What he was saying was so boring that I fell asleep.",
"h": "type: adj"
},
{
"f": "acceder (a)",
"b": "to access, get into; to agree to",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Suscríbete para acceder a más contenidos. Subscribe to access more content.",
"h": "type: verb"
},
{
"f": "corriente",
"b": "ordinary, common; (la corriente) current, electricity",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Es un reloj corriente. It's an ordinary watch. Se ha ido la corriente. The power has gone. The common currents: the run of the mill!",
"h": "type: adj; nf"
},
{
"f": "extrañar",
"b": "to miss (someone); to surprise",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Cuando viaja, extraña mucho a sus perros. When she travels, she misses her dogs a lot. extraño / extraña = strange",
"h": "type: verb"
},
{
"f": "házmelo saber",
"b": "let me know",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "haz (do/make!, imperative of hacer) + me (to me) + lo (it) + saber (to know): \"make it known to me\". The accent on há keeps the stress where it was.",
"h": "type: phrase"
},
{
"f": "malvado / malvada",
"b": "wicked, evil; villain",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Memory trick: mal = bad, so malvado = a bad person. (-ado isn't really a \"person\" suffix, but the trick works.)",
"h": "type: adj; n"
},
{
"f": "montón (el)",
"b": "pile, heap; a lot",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Había un montón de fotos antiguas. There were loads of old photos.",
"h": "type: nm"
},
{
"f": "tratar (de)",
"b": "to try (to); to treat",
"s": "spanishvocab1",
"g": "Words from my scripts",
"x": "Trataré de responderte. I will try to answer you. (trataré = future, \"I will try\")",
"h": "type: verb"
},
